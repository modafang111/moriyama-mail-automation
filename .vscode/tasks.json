{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "セットアップ",
      "type": "shell",
      "command": "python3 scripts/setup_local.py",
      "windows": {
        "command": "scripts\\ensure_venv.bat",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "WordPressフォームを配置",
      "type": "shell",
      "command": "python3 scripts/deploy_wordpress_form.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "MORIYAMA_INSTALL_DIR": "${workspaceFolder}"
        }
      },
      "windows": {
        "command": "scripts\\run_deploy_wordpress.bat",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "依頼の通知を送る",
      "type": "shell",
      "command": "python3 scripts/notify_wordpress_pending.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "MORIYAMA_INSTALL_DIR": "${workspaceFolder}"
        }
      },
      "windows": {
        "command": "scripts\\run_notify_pending.bat",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      "problemMatcher": []
    }
  ]
}
