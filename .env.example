# Copy this file to .env and fill in values on the local PC.
# Never commit .env or any real credentials.

# --- Operator / safety ---
MORIYAMA_INSTALL_DIR=D:\dev\moriyama-mail-automation

# Optional override. Default: %LOCALAPPDATA%\MoriyamaMailAutomation
# MORIYAMA_DATA_DIR=D:\dev\moriyama-mail-automation\data

OPERATOR_NAME=モダ

# Confirmation addresses for TEST delivery only (comma-separated).
# Not specified yet. Production never uses this list.
TEST_RECIPIENTS=

# Dedicated-form notifications. Two slots; the second address is not specified yet.
NOTIFY_ENABLED=true
NOTIFY_TO=modafang111@gmail.com
NOTIFY_TO_2=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Google Drive ---
GOOGLE_DRIVE_MODE=mock
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_LINK_LABEL=買取案件紹介

# --- MyASP ---
# Two plans, selected on the request form. Rename when the official names are known.
MYASP_MODE=mock
MYASP_LOGIN_URL=
MYASP_USER=
MYASP_PASSWORD=
MYASP_API_KEY=
MYASP_SERVER_URL=
MYASP_MCP_URL=
MYASP_PLAN_1_NAME=プラン1
MYASP_PLAN_1_SCENARIO_ID=
MYASP_PLAN_2_NAME=プラン2
MYASP_PLAN_2_SCENARIO_ID=
