# Copy this file to .env in the folder you opened. Never commit .env.
# Cursor で開いたフォルダが配置場所になります。空ならプログラム側でそのフォルダを使います。

MORIYAMA_INSTALL_DIR=
OPERATOR_NAME=モダ

