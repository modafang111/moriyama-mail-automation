WORDPRESS_FTP_PASSWORD=
WORDPRESS_FTP_PORT=21
WORDPRESS_FTP_REMOTE_DIR=public_html/mail-request
WORDPRESS_FTP_TLS=1

GOOGLE_DRIVE_MODE=mock
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_TOKEN_JSON=
