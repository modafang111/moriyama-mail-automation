# Copy this file to .env and fill in values on the local PC.
# Never commit .env or any real credentials.

# --- Operator / safety ---
# Windows local install path (documentation / default data parent)
MORIYAMA_INSTALL_DIR=D:\dev\moriyama-mail-automation

# Optional override. Default: %LOCALAPPDATA%\MoriyamaMailAutomation
# MORIYAMA_DATA_DIR=D:\dev\moriyama-mail-automation\data

# Displayed in history. Do not put passwords here.
OPERATOR_NAME=

# Confirmation addresses for TEST delivery only (comma-separated).
# Production delivery never uses this list as a substitute for MyASP subscribers.
TEST_RECIPIENTS=

# Notify the operator when a new request/campaign is registered.
NOTIFY_ENABLED=true
NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Google Drive ---
# mock: no real upload (Phase 1 default until credentials exist)
# live: Google Drive API v3
GOOGLE_DRIVE_MODE=mock
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_TOKEN_JSON=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_LINK_LABEL=買取案件紹介

# --- MyASP ---
# mock: Phase 1. live will be added after credentials and a chosen automation path.
MYASP_MODE=mock
MYASP_LOGIN_URL=
MYASP_USER=
MYASP_PASSWORD=
MYASP_API_KEY=
MYASP_SERVER_URL=
MYASP_MCP_URL=
MYASP_SCENARIO_ID=
